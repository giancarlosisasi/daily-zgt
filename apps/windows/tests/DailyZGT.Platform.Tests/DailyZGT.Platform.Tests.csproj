    <Compile Include="..\..\src\DailyZGT\Platform\Hotkey\ShortcutFormatter.cs" Link="Platform\ShortcutFormatter.cs" />
    <Compile Include="..\..\src\DailyZGT\Platform\Startup\IStartupRegistration.cs" Link="Platform\IStartupRegistration.cs" />
    <Compile Include="..\..\src\DailyZGT\Platform\Tray\TrayBadge.cs" Link="Platform\TrayBadge.cs" />
