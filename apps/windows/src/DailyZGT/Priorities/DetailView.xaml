<UserControl x:Class="DailyZGT.Priorities.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:DailyZGT.Theme"
             xmlns:p="clr-namespace:DailyZGT.Priorities"
             xmlns:core="clr-namespace:DailyZGT.Core.Domain;assembly=DailyZGT.Core"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PriorityStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BoxLabel" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text.Meta}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <!-- F09. The title field: no chrome until the pointer is over it or it has the focus. -->
            <Style x:Key="TitleField" TargetType="TextBox" BasedOn="{StaticResource Tecla.TextBox}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.Strong}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize.PanelTitle}" />
                <Setter Property="FontWeight" Value="{DynamicResource FontWeight.PanelTitle}" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="Margin" Value="-6,0" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.Line}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="DetailConfirmation" DataType="{x:Type p:DetailItem}">
                <p:ConfirmBar p:Moves.EnterOnLoad="True"
                              Hint="{Binding OpenSubtasksHint}"
                              CancelCommand="{Binding CancelDone}"
                              ConfirmCommand="{Binding ConfirmDone}" />
            </DataTemplate>

            <p:WhenSet x:Key="WhenConfirming" Template="{StaticResource DetailConfirmation}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel x:Name="Root" PreviewMouseLeftButtonDown="OnRootMouseDown" Background="Transparent">
        <Grid>
            <Button Style="{StaticResource Tecla.GhostButton}" HorizontalAlignment="Left"
                    Height="26" Padding="4,0,8,0"
                    Foreground="{DynamicResource Brush.Panel.Link}"
                    FontSize="{DynamicResource FontSize.Panel}"
                    Command="{Binding Back}"
                    AutomationProperties.AutomationId="DetailBack"
                    AutomationProperties.Name="{Binding BackName}">
                <StackPanel Orientation="Horizontal">
                    <theme:IconView Kind="CaretLeft" Size="14" Margin="0,0,2,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BackLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Tecla.IconButton.Detail}" HorizontalAlignment="Right"
                    Command="{Binding Delete}"
                    ToolTip="{p:Text DetailDelete}"
                    AutomationProperties.AutomationId="DetailDelete"
                    AutomationProperties.Name="{p:Text DetailDelete}">
                <theme:IconView Kind="Trash" Size="14" />
            </Button>
        </Grid>

        <TextBox x:Name="TitleBox" Style="{StaticResource TitleField}" Margin="-6,12,-6,0"
                 Text="{Binding Model.TitleDraft, UpdateSourceTrigger=PropertyChanged}"
                 GotKeyboardFocus="OnTitleFocus"
                 LostKeyboardFocus="OnTitleBlur"
                 PreviewKeyDown="OnTitleKey"
                 AutomationProperties.AutomationId="DetailTitle"
                 AutomationProperties.Name="{p:Text TitleField}" />

        <WrapPanel Margin="0,6,0,0">
            <ContentControl Style="{StaticResource Tecla.Chip.Later}" Padding="7,1" Margin="0,0,6,0"
                            Content="{Binding StateLabel}" />
            <ContentControl Padding="7,1" Margin="0,0,6,0"
                            Style="{Binding Due.Tone, Converter={x:Static p:ChipStyleConverter.Instance}}"
                            Content="{Binding Due.Label}"
                            Visibility="{Binding Due, Converter={x:Static p:ShownConverter.Instance}}" />
            <ContentControl Style="{StaticResource Tecla.Chip.Later}" Padding="7,1" Margin="0,0,6,0"
                            Content="{Binding Since.Label}"
                            Visibility="{Binding Since, Converter={x:Static p:ShownConverter.Instance}}" />
            <TextBlock Style="{StaticResource Tecla.Text.Meta}" VerticalAlignment="Center"
                       Text="{Binding SubtasksChip}"
                       Visibility="{Binding SubtasksChip, Converter={x:Static p:ShownConverter.Instance}}" />
        </WrapPanel>

        <Border Style="{StaticResource Tecla.Card.Quiet}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource BoxLabel}" Text="{p:Text LabelPriority}" />
                <Border Grid.Column="1" Style="{StaticResource Tecla.SegmentTrack.Form}">
                    <UniformGrid Columns="3">
                        <RadioButton Style="{StaticResource Tecla.SegmentButton.Form}" Margin="0,0,2,0"
                                     IsChecked="{Binding Level, Converter={x:Static p:IsValueConverter.Instance}, ConverterParameter={x:Static core:PriorityLevel.High}}"
                                     AutomationProperties.AutomationId="LevelHigh"
                                     AutomationProperties.Name="{p:Text LevelHighName}">
                            <StackPanel Orientation="Horizontal">
                                <theme:LevelBars Level="High" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{p:Text LevelHigh}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Tecla.SegmentButton.Form}" Margin="0,0,2,0"
                                     IsChecked="{Binding Level, Converter={x:Static p:IsValueConverter.Instance}, ConverterParameter={x:Static core:PriorityLevel.Medium}}"
                                     AutomationProperties.AutomationId="LevelMedium"
                                     AutomationProperties.Name="{p:Text LevelMediumName}">
                            <StackPanel Orientation="Horizontal">
                                <theme:LevelBars Level="Medium" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{p:Text LevelMedium}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Tecla.SegmentButton.Form}"
                                     IsChecked="{Binding Level, Converter={x:Static p:IsValueConverter.Instance}, ConverterParameter={x:Static core:PriorityLevel.Low}}"
                                     AutomationProperties.AutomationId="LevelLow"
                                     AutomationProperties.Name="{p:Text LevelLowName}">
                            <StackPanel Orientation="Horizontal">
                                <theme:LevelBars Level="Low" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{p:Text LevelLow}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>

                <TextBlock Grid.Row="1" Style="{StaticResource BoxLabel}" Text="{p:Text LabelDue}" Margin="0,8,8,0" />
                <p:DueField x:Name="DetailDue" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                            Value="{Binding DueAt, Mode=OneWay}"
                            Clock="{Binding Clock}" />

                <TextBlock Grid.Row="2" Style="{StaticResource BoxLabel}" Text="{p:Text LabelList}" Margin="0,8,8,0" />
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Tecla.SegmentTrack.Form}" Margin="0,8,0,0">
                    <UniformGrid Columns="2">
                        <RadioButton Style="{StaticResource Tecla.SegmentButton.Form}" Margin="0,0,2,0"
                                     Content="{p:Text ScopeToday}"
                                     IsChecked="{Binding List, Converter={x:Static p:IsValueConverter.Instance}, ConverterParameter={x:Static core:PriorityList.Today}}"
                                     AutomationProperties.AutomationId="DetailListToday" />
                        <RadioButton Style="{StaticResource Tecla.SegmentButton.Form}"
                                     Content="{p:Text ScopeWeek}"
                                     IsChecked="{Binding List, Converter={x:Static p:IsValueConverter.Instance}, ConverterParameter={x:Static core:PriorityList.Week}}"
                                     AutomationProperties.AutomationId="DetailListWeek" />
                    </UniformGrid>
                </Border>

                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Priorities.Notice}" Margin="0,8,0,0"
                           Text="{p:Text TodayLimitMessage}"
                           Visibility="{Binding Model.ShowsLimitNotice, Converter={x:Static p:ShownConverter.Instance}}"
                           AutomationProperties.AutomationId="LimitNotice" />

                <TextBlock Grid.Row="4" Style="{StaticResource BoxLabel}" Text="{p:Text LabelRepeat}" Margin="0,8,8,0" />
                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource Tecla.SegmentTrack.Form}" Margin="0,8,0,0">
                    <UniformGrid Columns="2">
                        <RadioButton Style="{StaticResource Tecla.SegmentButton.Form}" Margin="0,0,2,0"
                                     Content="{p:Text RepeatNo}"
                                     IsChecked="{Binding Repeat, Converter={x:Static p:IsValueConverter.Instance}, ConverterParameter={x:Static core:RepeatRule.None}}"
                                     AutomationProperties.AutomationId="DetailRepeatNo" />
                        <RadioButton Style="{StaticResource Tecla.SegmentButton.Form}"
                                     Content="{p:Text RepeatDaily}"
                                     IsChecked="{Binding Repeat, Converter={x:Static p:IsValueConverter.Instance}, ConverterParameter={x:Static core:RepeatRule.Daily}}"
                                     AutomationProperties.AutomationId="DetailRepeatDaily" />
                    </UniformGrid>
                </Border>

                <TextBlock Grid.Row="5" Style="{StaticResource BoxLabel}" Text="{p:Text LabelAlert}" Margin="0,8,8,0"
                           VerticalAlignment="Top" />
                <p:AlertHint Grid.Row="5" Grid.Column="1" Margin="0,8,0,0"
                             HasDue="{Binding HasDue}"
                             Text="{Binding AlertText}"
                             FontSize="{DynamicResource FontSize.PanelLabel}"
                             Foreground="{DynamicResource Brush.Panel.Text2}"
                             AutomationProperties.AutomationId="DetailAlert" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource Priorities.SectionTitle}" Margin="0,12,0,4" Text="{p:Text SectionSubtasks}" />
        <p:SubtaskList DataContext="{Binding Subtasks}" RowGap="0,0,0,4" FieldGap="0" />

        <TextBlock Style="{StaticResource Priorities.SectionTitle}" Margin="0,12,0,4" Text="{p:Text SectionNotes}" />
        <TextBox x:Name="NoteBox" Style="{StaticResource Tecla.NoteBox}" Height="110" Padding="10,9"
                 theme:Field.Placeholder="{p:Text NotePlaceholder}"
                 Text="{Binding Note.Text, UpdateSourceTrigger=PropertyChanged}"
                 LostKeyboardFocus="OnNoteBlur"
                 AutomationProperties.AutomationId="DetailNote"
                 AutomationProperties.Name="{p:Text SectionNotes}" />
        <TextBlock Style="{StaticResource Tecla.Text.Meta}" Margin="0,4,0,0"
                   Text="{p:Text NoteSaveFailed}"
                   Visibility="{Binding Note.SaveFailed, Converter={x:Static p:ShownConverter.Instance}}" />

        <Grid Margin="0,12,0,0">
            <Button Style="{StaticResource Tecla.KeyButton}" Height="30" Margin="0,0,0,2"
                    theme:KeyFace.Radius="{DynamicResource Radius.Row}"
                    Foreground="{DynamicResource Brush.Panel.DoneText}"
                    FontSize="{DynamicResource FontSize.Panel}"
                    FontWeight="SemiBold"
                    Command="{Binding MarkDone}"
                    Visibility="{Binding IsConfirming, Converter={x:Static p:ShownConverter.Inverted}}"
                    AutomationProperties.AutomationId="DetailMarkDone"
                    AutomationProperties.Name="{p:Text MarkDoneButton}">
                <StackPanel Orientation="Horizontal">
                    <theme:IconView Kind="Check" Size="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{p:Text MarkDoneButton}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <ContentControl Focusable="False" Content="{Binding Confirmation}" ContentTemplateSelector="{StaticResource WhenConfirming}" />
        </Grid>

        <TextBlock Style="{StaticResource Tecla.Text.Dim}" Margin="0,12,0,0" Text="{Binding Created}" />
        <TextBlock Style="{StaticResource Tecla.Text.Meta}" Margin="0,4,0,0"
                   Text="{p:Text ListSaveFailed}"
                   Visibility="{Binding SaveFailed, Converter={x:Static p:ShownConverter.Instance}}" />
    </StackPanel>
</UserControl>
