<UserControl x:Class="DailyZGT.Priorities.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:DailyZGT.Theme"
             xmlns:p="clr-namespace:DailyZGT.Priorities"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary Source="PriorityStyles.xaml" />
    </UserControl.Resources>

    <StackPanel x:Name="Root">
        <Grid>
            <Button Style="{StaticResource Tecla.GhostButton}" HorizontalAlignment="Left"
                    Height="26" Padding="4,0,8,0"
                    Foreground="{DynamicResource Brush.Panel.Link}"
                    FontSize="{DynamicResource FontSize.Panel}"
                    Command="{Binding Back}"
                    AutomationProperties.AutomationId="HistoryBack"
                    AutomationProperties.Name="{p:Text HistoryBack}">
                <StackPanel Orientation="Horizontal">
                    <theme:IconView Kind="CaretLeft" Size="14" Margin="0,0,2,0" VerticalAlignment="Center" />
                    <TextBlock Text="{p:Text HistoryTitle}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource Tecla.Text.Label}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding ListTitle}"
                       AutomationProperties.AutomationId="HistoryList" />
        </Grid>

        <TextBlock Style="{StaticResource Tecla.Text.Body}" Foreground="{DynamicResource Brush.Panel.Muted}"
                   Margin="8,26,8,14"
                   Text="{p:Text HistoryEmpty}"
                   Visibility="{Binding HasGroups, Converter={x:Static p:ShownConverter.Inverted}}"
                   AutomationProperties.AutomationId="HistoryEmpty" />

        <ScrollViewer MaxHeight="330" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding HasGroups, Converter={x:Static p:ShownConverter.Instance}}">
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type p:HistoryGroupItem}">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Tecla.Text.LabelStrong}" Margin="8,0,8,2" Text="{Binding Title}" />
                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource Priorities.DoneRow}" Focusable="False" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
