<UserControl x:Class="DailyZGT.Priorities.UndoBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:DailyZGT.Theme"
             xmlns:p="clr-namespace:DailyZGT.Priorities"
             Focusable="False"
             Visibility="Collapsed">
    <p:GroupBorder x:Name="Bar" Style="{StaticResource Tecla.UndoBar}" SizeChanged="OnBarSized"
                   AutomationProperties.AutomationId="UndoBar">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <theme:IconView Kind="Check" Size="12" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Panel.Done}" />
            <TextBlock x:Name="Line" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                       Style="{StaticResource Tecla.Text.Label}"
                       Foreground="{DynamicResource Brush.Panel.Text2}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       AutomationProperties.AutomationId="UndoText" />
            <Button Grid.Column="2" Style="{StaticResource Tecla.GhostButton.Link}"
                    Content="{p:Text Undo}"
                    Click="OnUndo"
                    AutomationProperties.AutomationId="UndoButton" />
            <Border x:Name="Progress" Grid.ColumnSpan="3" Margin="-10,0,-6,-6" Style="{StaticResource Tecla.UndoLine}" />
        </Grid>
    </p:GroupBorder>
</UserControl>
