<UserControl x:Class="DailyZGT.Priorities.DueField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:DailyZGT.Theme"
             xmlns:p="clr-namespace:DailyZGT.Priorities"
             x:Name="Self"
             AutomationProperties.AutomationId="DueField"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary Source="PriorityStyles.xaml" />
    </UserControl.Resources>
    <Grid>
        <Button x:Name="EmptyButton" Style="{StaticResource Priorities.DueInput}" Click="OnEmptyClick"
                AutomationProperties.AutomationId="DueButton"
                AutomationProperties.Name="{p:Text LabelDue}">
            <Grid>
                <TextBlock Style="{StaticResource Tecla.Text.Label}" Foreground="{DynamicResource Brush.Panel.Dim}"
                           Text="{p:Text NoDate}" VerticalAlignment="Center" />
                <theme:IconView Kind="Calendar" Size="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.Panel.Muted}" />
            </Grid>
        </Button>
        <Grid x:Name="DateRow" Visibility="Collapsed">
            <Button x:Name="DateButton" Style="{StaticResource Priorities.DueInput}" Click="OnDateClick" Padding="8,0,30,0"
                    AutomationProperties.AutomationId="DueButton"
                    AutomationProperties.Name="{p:Text LabelDue}">
                <TextBlock x:Name="DateText" Style="{StaticResource Tecla.Text.Label}"
                           Foreground="{DynamicResource Brush.Panel.Text2}" VerticalAlignment="Center" />
            </Button>
            <Button Style="{StaticResource Tecla.GhostButton}" Width="20" Height="20" Padding="0" Margin="0,0,4,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.Panel.Muted}"
                    Click="OnClearClick"
                    ToolTip="{p:Text ClearDate}"
                    AutomationProperties.AutomationId="DueClear"
                    AutomationProperties.Name="{p:Text ClearDate}">
                <theme:IconView Kind="Close" Size="10" />
            </Button>
        </Grid>
        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=Self}"
               Placement="Bottom"
               HorizontalOffset="-8"
               VerticalOffset="-2"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="None"
               Opened="OnPopupOpened"
               Closed="OnPopupClosed">
            <p:DuePicker x:Name="Picker" />
        </Popup>
    </Grid>
</UserControl>
