<UserControl x:Class="DailyZGT.Priorities.DuePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:DailyZGT.Theme"
             xmlns:p="clr-namespace:DailyZGT.Priorities"
             Focusable="False"
             AutomationProperties.AutomationId="DuePicker"
             AutomationProperties.Name="{p:Text LabelDue}">
    <UserControl.Resources>
        <ResourceDictionary Source="PriorityStyles.xaml" />
    </UserControl.Resources>
    <Border Margin="8,6,8,16"
            Width="252"
            Padding="10"
            Background="{DynamicResource Brush.Panel.ToastBg}"
            BorderBrush="{DynamicResource Brush.Panel.Line}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Bar}"
            Effect="{DynamicResource Effect.Alert.0}"
            TextElement.Foreground="{DynamicResource Brush.Panel.Text}"
            TextElement.FontFamily="{DynamicResource Font.Text}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Tecla.IconButton}" Click="OnPreviousMonth"
                        ToolTip="{p:Text PickerPreviousMonth}"
                        AutomationProperties.AutomationId="PickerPreviousMonth"
                        AutomationProperties.Name="{p:Text PickerPreviousMonth}">
                    <theme:IconView Kind="CaretLeft" Size="12" />
                </Button>
                <TextBlock x:Name="MonthTitle" Grid.Column="1" Style="{StaticResource Tecla.Text.BodyStrong}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="PickerMonth" />
                <Button Grid.Column="2" Style="{StaticResource Tecla.IconButton}" Click="OnNextMonth"
                        ToolTip="{p:Text PickerNextMonth}"
                        AutomationProperties.AutomationId="PickerNextMonth"
                        AutomationProperties.Name="{p:Text PickerNextMonth}">
                    <theme:IconView Kind="CaretRight" Size="12" />
                </Button>
            </Grid>
            <UniformGrid x:Name="WeekdayRow" Columns="7" Margin="0,8,0,2" />
            <UniformGrid x:Name="Days" Columns="7" Rows="6" />
            <Border Style="{StaticResource Tecla.Divider}" Margin="0,8,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Tecla.Text.Meta}" Text="{p:Text PickerHour}" Margin="1,0,0,3" />
                <TextBlock Grid.Column="2" Style="{StaticResource Tecla.Text.Meta}" Text="{p:Text PickerMinute}" Margin="1,0,0,3" />
                <TextBox x:Name="HourBox" Grid.Row="1" Style="{StaticResource Tecla.TextBox}"
                         Width="44" Height="28" Padding="6,0" MaxLength="2" HorizontalContentAlignment="Center"
                         AutomationProperties.AutomationId="PickerHour"
                         AutomationProperties.Name="{p:Text PickerHour}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Tecla.Text.BodyStrong}" Text=":"
                           Margin="5,0" VerticalAlignment="Center" />
                <TextBox x:Name="MinuteBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource Tecla.TextBox}"
                         Width="44" Height="28" Padding="6,0" MaxLength="2" HorizontalContentAlignment="Center"
                         AutomationProperties.AutomationId="PickerMinute"
                         AutomationProperties.Name="{p:Text PickerMinute}" />
                <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource Tecla.KeyButton.Primary}"
                        Padding="12,0" Margin="0,0,0,2" Click="OnDone"
                        Content="{p:Text PickerDone}"
                        AutomationProperties.AutomationId="PickerDone" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
