<Application x:Class="DailyZGT.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:DailyZGT.Theme"
             xmlns:dz="clr-namespace:DailyZGT"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:TeclaTokenResources />
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/Typography.xaml" />
                <ResourceDictionary Source="Theme/Buttons.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
                <ResourceDictionary Source="Theme/Inputs.xaml" />
                <ResourceDictionary Source="Theme/Surfaces.xaml" />
                <ResourceDictionary Source="Theme/Scroll.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The Texts catalog of the current language, for {Binding Quit, Source={StaticResource Texts}}. -->
            <x:Static x:Key="Texts" Member="dz:UiText.Current" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
