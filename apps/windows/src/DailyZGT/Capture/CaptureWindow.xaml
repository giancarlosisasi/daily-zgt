<Window x:Class="DailyZGT.Capture.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:DailyZGT.Theme"
        Title="Daily ZGT"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="CaptureWindow">
    <ContentControl x:Name="Surface"
                    Style="{StaticResource Tecla.Panel}"
                    Padding="11"
                    Margin="28,20,28,50">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <theme:IconView Kind="Crosshair"
                                Size="14"
                                Foreground="{DynamicResource Brush.Panel.Text}"
                                VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Tecla.Text.LabelStrong}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding CaptureTitle, Source={StaticResource Texts}}" />
            </StackPanel>
            <TextBox x:Name="Field"
                     Style="{StaticResource Tecla.TextBox.Capture}"
                     Margin="0,8,0,0"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     theme:Field.Placeholder="{Binding TitlePlaceholder, Source={StaticResource Texts}}"
                     AutomationProperties.AutomationId="CaptureField"
                     AutomationProperties.Name="{Binding CaptureTitle, Source={StaticResource Texts}}"
                     PreviewKeyDown="OnFieldKey" />
            <TextBlock x:Name="Notice"
                       Style="{StaticResource Tecla.Text.Meta}"
                       Foreground="{DynamicResource Brush.Panel.Text2}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="CaptureNotice" />
            <TextBlock Style="{StaticResource Tecla.Text.Meta}"
                       Margin="0,8,0,0"
                       Text="{Binding CaptureHint, Source={StaticResource Texts}}" />
        </StackPanel>
    </ContentControl>
</Window>
