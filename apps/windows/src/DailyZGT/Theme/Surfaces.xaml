<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:DailyZGT.Theme">

    <ControlTemplate x:Key="Tecla.PanelTemplate" TargetType="ContentControl">
        <Grid SnapsToDevicePixels="True">
            <Border Background="{DynamicResource Brush.Panel.Bg}"
                    CornerRadius="{DynamicResource Radius.Panel}"
                    Effect="{DynamicResource Effect.Panel.1}"
                    IsHitTestVisible="False" />
            <Border Background="{DynamicResource Brush.Shadow.Panel.0}"
                    CornerRadius="{DynamicResource Radius.Panel}"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform Y="{x:Static theme:TeclaTokens+Key.PanelSideHeight}" />
                </Border.RenderTransform>
            </Border>
            <Border Background="{DynamicResource Brush.Panel.Bg}"
                    BorderBrush="{DynamicResource Brush.Panel.Line}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Panel}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter />
            </Border>
        </Grid>
    </ControlTemplate>

    <Style x:Key="Tecla.Panel" TargetType="ContentControl">
        <Setter Property="Width" Value="360" />
        <Setter Property="Padding" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Panel}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template" Value="{StaticResource Tecla.PanelTemplate}" />
    </Style>

    <Style x:Key="Tecla.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Bar}" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="Tecla.Card.Quiet" TargetType="Border" BasedOn="{StaticResource Tecla.Card}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.Div}" />
    </Style>

    <Style x:Key="Tecla.ConfirmBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.DoneBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.DoneLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Bar}" />
        <Setter Property="Padding" Value="10,7,8,7" />
    </Style>

    <Style x:Key="Tecla.ConfirmBar.InRow" TargetType="Border" BasedOn="{StaticResource Tecla.ConfirmBar}">
        <Setter Property="Margin" Value="30,2,4,4" />
    </Style>

    <Style x:Key="Tecla.UndoBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.Undo}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Bar}" />
        <Setter Property="Padding" Value="10,6,6,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Tecla.UndoLine" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.Link}" />
        <Setter Property="Height" Value="{DynamicResource Size.UndoLine}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="Tecla.Row" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Row}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="4,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Panel.Hover}" />
                <Setter Property="theme:RowState.Hovered" Value="True" />
            </Trigger>
            <Trigger Property="theme:RowState.Highlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Panel.Hl}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Tecla.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.Div}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Tecla.Footer" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.Div}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="4,8,4,0" />
    </Style>

    <ControlTemplate x:Key="Tecla.ChipTemplate" TargetType="ContentControl">
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource Radius.Chip}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter />
        </Border>
    </ControlTemplate>

    <Style x:Key="Tecla.Chip" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.PanelChip}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.PanelChip}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource Tecla.ChipTemplate}" />
    </Style>

    <Style x:Key="Tecla.Chip.Overdue" TargetType="ContentControl" BasedOn="{StaticResource Tecla.Chip}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.LateT}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.LateBg}" />
    </Style>

    <Style x:Key="Tecla.Chip.Soon" TargetType="ContentControl" BasedOn="{StaticResource Tecla.Chip}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.SoonT}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.SoonBg}" />
    </Style>

    <Style x:Key="Tecla.Chip.Later" TargetType="ContentControl" BasedOn="{StaticResource Tecla.Chip}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.LaterT}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.LaterBg}" />
    </Style>

    <Style x:Key="Tecla.Chip.Done" TargetType="ContentControl" BasedOn="{StaticResource Tecla.Chip}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.DoneText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.DoneBg}" />
        <Setter Property="Padding" Value="7,1" />
    </Style>
</ResourceDictionary>
