<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:DailyZGT.Theme">

    <Style x:Key="Tecla.SegmentTrack" TargetType="Border">
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Track}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.Track}" />
    </Style>

    <Style x:Key="Tecla.SegmentTrack.Top" TargetType="Border" BasedOn="{StaticResource Tecla.SegmentTrack}" />

    <Style x:Key="Tecla.SegmentTrack.Scope" TargetType="Border" BasedOn="{StaticResource Tecla.SegmentTrack}">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.Track2}" />
    </Style>

    <Style x:Key="Tecla.SegmentTrack.Form" TargetType="Border" BasedOn="{StaticResource Tecla.SegmentTrack}">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Input}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.In}" />
    </Style>

    <ControlTemplate x:Key="Tecla.SegmentTemplate" TargetType="RadioButton">
        <Grid SnapsToDevicePixels="True" Background="Transparent">
            <Border Background="{DynamicResource Brush.Key.Side}"
                    CornerRadius="{Binding (theme:KeyFace.Radius), RelativeSource={RelativeSource TemplatedParent}}"
                    Opacity="{Binding (theme:Selection.Amount), RelativeSource={RelativeSource TemplatedParent}}">
                <Border.RenderTransform>
                    <TranslateTransform Y="{x:Static theme:TeclaTokens+Key.PanelSideHeight}" />
                </Border.RenderTransform>
            </Border>
            <Border Background="{DynamicResource Brush.Key.SelectedFace}"
                    CornerRadius="{Binding (theme:KeyFace.Radius), RelativeSource={RelativeSource TemplatedParent}}"
                    Opacity="{Binding (theme:Selection.Amount), RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="Tecla.SegmentButton" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Tecla.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.Muted}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.PanelLabel}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.PanelLabel}" />
        <Setter Property="theme:KeyFace.Radius" Value="{DynamicResource Radius.Segment}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource Tecla.SegmentTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.SegT}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.SegT}" />
                <Setter Property="theme:Selection.On" Value="True" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Tecla.SegmentButton.Top" TargetType="RadioButton" BasedOn="{StaticResource Tecla.SegmentButton}">
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Panel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Tecla.SegmentButton.Scope" TargetType="RadioButton" BasedOn="{StaticResource Tecla.SegmentButton}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style x:Key="Tecla.SegmentButton.Form" TargetType="RadioButton" BasedOn="{StaticResource Tecla.SegmentButton}">
        <Setter Property="Height" Value="24" />
        <Setter Property="theme:KeyFace.Radius" Value="{DynamicResource Radius.InputSegment}" />
    </Style>

    <ControlTemplate x:Key="Tecla.CheckboxTemplate" TargetType="CheckBox">
        <Grid SnapsToDevicePixels="True" Background="Transparent">
            <Border Background="{DynamicResource Brush.Key.Side}"
                    CornerRadius="{DynamicResource Radius.Checkbox}"
                    Opacity="{Binding (theme:KeyFace.SideOpacity), RelativeSource={RelativeSource TemplatedParent}}">
                <Border.RenderTransform>
                    <TranslateTransform Y="{Binding (theme:KeyFace.SideHeight), RelativeSource={RelativeSource TemplatedParent}}" />
                </Border.RenderTransform>
            </Border>
            <Border x:Name="Face"
                    Background="{DynamicResource Brush.Key.Face}"
                    CornerRadius="{DynamicResource Radius.Checkbox}">
                <Border.RenderTransform>
                    <TranslateTransform Y="{Binding (theme:KeyFace.Offset), RelativeSource={RelativeSource TemplatedParent}}" />
                </Border.RenderTransform>
                <Grid>
                    <Border x:Name="Ring"
                            BorderBrush="{DynamicResource Brush.Panel.Cb}"
                            BorderThickness="{DynamicResource Thickness.CheckboxLine}"
                            CornerRadius="{DynamicResource Radius.Checkbox}" />
                    <Border Background="{DynamicResource Brush.Panel.PressTint}"
                            CornerRadius="{DynamicResource Radius.Checkbox}"
                            Opacity="{Binding (theme:KeyFace.Tint), RelativeSource={RelativeSource TemplatedParent}}" />
                    <Grid x:Name="Check" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="10*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="3*" />
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="1" Grid.Column="1" Stretch="Uniform">
                            <theme:IconView Kind="Check" Size="16" Foreground="{DynamicResource Brush.Panel.OnAccent}" />
                        </Viewbox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Panel.Accent}" />
                <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Tecla.PriorityCheckbox" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Tecla.FocusVisual}" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template" Value="{StaticResource Tecla.CheckboxTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="theme:KeyFace.Pressed" Value="True" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="theme:KeyFace.StaysDown" Value="True" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Tecla.SubtaskCheckbox" TargetType="CheckBox" BasedOn="{StaticResource Tecla.PriorityCheckbox}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <ControlTemplate x:Key="Tecla.SwitchTemplate" TargetType="ToggleButton">
        <Grid Width="{x:Static theme:SwitchKnob.Width}"
              Height="{x:Static theme:SwitchKnob.Height}"
              SnapsToDevicePixels="True"
              Background="Transparent">
            <Border Background="{DynamicResource Brush.Colors.Surface2}" CornerRadius="15" />
            <Border Background="{DynamicResource Brush.Colors.Fill}"
                    CornerRadius="15"
                    Opacity="{Binding (theme:SwitchKnob.Position), RelativeSource={RelativeSource TemplatedParent}}" />
            <Path Fill="{DynamicResource Brush.Panel.Track}">
                <Path.Data>
                    <CombinedGeometry GeometryCombineMode="Exclude">
                        <CombinedGeometry.Geometry1>
                            <RectangleGeometry Rect="0,0,52,30" RadiusX="15" RadiusY="15" />
                        </CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                            <RectangleGeometry Rect="0,2,52,30" RadiusX="15" RadiusY="15" />
                        </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                </Path.Data>
            </Path>
            <Grid Width="{x:Static theme:SwitchKnob.KnobSize}"
                  Height="{x:Static theme:SwitchKnob.KnobSize}"
                  Margin="3"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <TranslateTransform X="{Binding (theme:SwitchKnob.Position), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static theme:ScaleConverter.Instance}, ConverterParameter={x:Static theme:SwitchKnob.KnobTravel}}" />
                </Grid.RenderTransform>
                <Border Background="{DynamicResource Brush.Key.Side}"
                        CornerRadius="8"
                        Opacity="{Binding (theme:KeyFace.SideOpacity), RelativeSource={RelativeSource TemplatedParent}}">
                    <Border.RenderTransform>
                        <TranslateTransform Y="{Binding (theme:KeyFace.SideHeight), RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border.RenderTransform>
                </Border>
                <Border Background="{DynamicResource Brush.Colors.Knob}" CornerRadius="8">
                    <Border.RenderTransform>
                        <TranslateTransform Y="{Binding (theme:KeyFace.Offset), RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border.RenderTransform>
                    <Border Background="{DynamicResource Brush.Panel.PressTint}"
                            CornerRadius="8"
                            Opacity="{Binding (theme:KeyFace.Tint), RelativeSource={RelativeSource TemplatedParent}}" />
                </Border>
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style x:Key="Tecla.Switch" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Tecla.FocusVisual}" />
        <Setter Property="Template" Value="{StaticResource Tecla.SwitchTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="theme:KeyFace.Pressed" Value="True" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="theme:SwitchKnob.IsOn" Value="True" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
