<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Tecla.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Panel}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Tecla.Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text}" />

    <Style x:Key="Tecla.Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Tecla.Text.RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text}">
        <Setter Property="LineHeight" Value="{DynamicResource LineHeight.Panel}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Tecla.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.PanelTitle}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.PanelTitle}" />
    </Style>

    <Style x:Key="Tecla.Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.PanelLabel}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.PanelLabel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.Muted}" />
    </Style>

    <Style x:Key="Tecla.Text.LabelStrong" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text.Label}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Tecla.Text.Meta" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.PanelMeta}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.PanelMeta}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.Muted}" />
    </Style>

    <Style x:Key="Tecla.Text.MetaStrong" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text.Meta}">
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.PanelChip}" />
    </Style>

    <Style x:Key="Tecla.Text.Dim" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text.Meta}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.Dim}" />
    </Style>

    <Style x:Key="Tecla.Text.Link" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text.LabelStrong}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.Link}" />
    </Style>

    <Style x:Key="Tecla.Text.Capture" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.PanelCapture}" />
    </Style>

    <Style x:Key="Tecla.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Code}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.Code}" />
    </Style>

    <Style x:Key="Tecla.Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Subhead}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.Subhead}" />
    </Style>
</ResourceDictionary>
