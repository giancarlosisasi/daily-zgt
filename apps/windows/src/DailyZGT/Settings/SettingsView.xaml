<UserControl x:Class="DailyZGT.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:DailyZGT.Theme"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text.Body}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowDetail" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text.Meta}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,12,0" />
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock" BasedOn="{StaticResource Tecla.Text.Meta}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Panel.Text2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Button HorizontalAlignment="Left"
                Style="{StaticResource Tecla.GhostButton.Link}"
                Height="26"
                Padding="4,0,8,0"
                FontWeight="Normal"
                FontSize="{DynamicResource FontSize.Panel}"
                AutomationProperties.AutomationId="SettingsBack"
                AutomationProperties.Name="{Binding SettingsClose, Source={StaticResource Texts}}"
                Click="OnBack">
            <StackPanel Orientation="Horizontal">
                <theme:IconView Kind="CaretLeft" Size="14" Margin="0,0,2,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SettingsTitle, Source={StaticResource Texts}}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Border Style="{StaticResource Tecla.Card.Quiet}" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{Binding LoginTitle, Source={StaticResource Texts}}" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{Binding LoginDetail, Source={StaticResource Texts}}" />
                    </StackPanel>
                    <ToggleButton x:Name="LoginSwitch"
                                  Grid.Column="1"
                                  Style="{StaticResource Tecla.Switch}"
                                  AutomationProperties.AutomationId="SettingLogin"
                                  AutomationProperties.Name="{Binding LoginTitle, Source={StaticResource Texts}}"
                                  Checked="OnLogin"
                                  Unchecked="OnLogin" />
                </Grid>
                <WrapPanel x:Name="LoginApproval" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource RowNote}" Margin="0,0,6,0" Text="{Binding LoginApproval, Source={StaticResource Texts}}" />
                    <Button Style="{StaticResource Tecla.GhostButton.Link}"
                            Height="20"
                            Padding="4,0"
                            FontSize="{DynamicResource FontSize.PanelMeta}"
                            Content="{Binding OpenSettings, Source={StaticResource Texts}}"
                            AutomationProperties.AutomationId="SettingLoginApproval"
                            Click="OnOpenStartupApps" />
                </WrapPanel>
                <TextBlock x:Name="LoginFailed"
                           Style="{StaticResource RowNote}"
                           Margin="0,8,0,0"
                           Text="{Binding LoginFailed, Source={StaticResource Texts}}"
                           AutomationProperties.AutomationId="SettingLoginFailed" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Tecla.Card.Quiet}" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="{Binding TodayLimitTitle, Source={StaticResource Texts}}" />
                    <TextBlock Style="{StaticResource RowDetail}" Text="{Binding TodayLimitDetail, Source={StaticResource Texts}}" />
                </StackPanel>
                <ToggleButton x:Name="TodayLimitSwitch"
                              Grid.Column="1"
                              Style="{StaticResource Tecla.Switch}"
                              AutomationProperties.AutomationId="SettingTodayLimit"
                              AutomationProperties.Name="{Binding TodayLimitTitle, Source={StaticResource Texts}}"
                              Checked="OnTodayLimit"
                                  Unchecked="OnTodayLimit" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Tecla.Card.Quiet}" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="{Binding NextPriorityTitle, Source={StaticResource Texts}}" />
                    <TextBlock Style="{StaticResource RowDetail}" Text="{Binding NextPriorityDetail, Source={StaticResource Texts}}" />
                </StackPanel>
                <ToggleButton x:Name="TrayTitleSwitch"
                              Grid.Column="1"
                              Style="{StaticResource Tecla.Switch}"
                              AutomationProperties.AutomationId="SettingTrayTitle"
                              AutomationProperties.Name="{Binding NextPriorityTitle, Source={StaticResource Texts}}"
                              Checked="OnTrayTitle"
                                  Unchecked="OnTrayTitle" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Tecla.Card.Quiet}" Margin="0,6,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{Binding ShortcutTitle, Source={StaticResource Texts}}" />
                        <TextBlock x:Name="ShortcutDetail" Style="{StaticResource RowDetail}" />
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ShortcutField"
                                Style="{StaticResource Tecla.KeyButton}"
                                MinWidth="110"
                                Margin="0,0,0,2"
                                AutomationProperties.AutomationId="ShortcutField"
                                AutomationProperties.Name="{Binding ShortcutTitle, Source={StaticResource Texts}}"
                                Click="OnShortcutClick"
                                PreviewKeyDown="OnShortcutKey"
                                LostKeyboardFocus="OnShortcutLostFocus">
                            <TextBlock x:Name="ShortcutText" />
                        </Button>
                        <Button x:Name="ShortcutClear"
                                Grid.Column="1"
                                Style="{StaticResource Tecla.IconButton}"
                                Margin="2,0,0,0"
                                ToolTip="{Binding ShortcutClear, Source={StaticResource Texts}}"
                                AutomationProperties.AutomationId="ShortcutClear"
                                AutomationProperties.Name="{Binding ShortcutClear, Source={StaticResource Texts}}"
                                Click="OnShortcutClear">
                            <theme:IconView Kind="Close" Size="11" />
                        </Button>
                    </Grid>
                </Grid>
                <TextBlock x:Name="ShortcutProblem"
                           Style="{StaticResource RowNote}"
                           Margin="0,8,0,0"
                           AutomationProperties.AutomationId="ShortcutFailure" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
