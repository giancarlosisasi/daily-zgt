<Window x:Class="DailyZGT.Shell.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily ZGT"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="PanelWindow">
    <ContentControl x:Name="Surface"
                    Style="{StaticResource Tecla.Panel}"
                    Margin="28,20,28,50"
                    VerticalAlignment="Top" />
</Window>
